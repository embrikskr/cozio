# Copy to .env and fill in. Never commit your real .env.

# --- Database --- Supabase Postgres
# DATABASE_URL = transaction pooler (6543, ?pgbouncer=true) — app runtime.
# DIRECT_URL   = session pooler (5432) — migrations (prisma db push/migrate).
# URL-encode special chars in the password (e.g. ! -> %21).
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://your-domain.com"

# --- App ---
NEXT_PUBLIC_APP_NAME="Cozio"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-haiku-4-5"

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PRICE_ID="price_..."        # the per-property graduated Price (see DEPLOY.md)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (Resend) ---
# Create a key at resend.com, verify your sending domain, and set EMAIL_FROM to
# an address on it. Leave blank to disable email (degrades gracefully).
RESEND_API_KEY="re_..."
EMAIL_FROM="Cozio <notifications@cozio.eu>"

# --- Image storage (Supabase Storage) ---
# In your Supabase project: Storage -> New bucket, name it "guide-images", and
# mark it PUBLIC (guest guides are public pages; their images must load without
# a session). Then Project Settings -> API for the two values below.
# The service role key bypasses row-level security — server-side only, never
# expose it to the browser and never prefix it with NEXT_PUBLIC_.
# Leave blank to disable uploads (the editor says so instead of breaking).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_STORAGE_BUCKET="guide-images"   # optional, this is the default

# --- Rate limiting (Upstash Redis) ---
# Create a free Redis DB at upstash.com (REST API). Blank = in-memory fallback.
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
